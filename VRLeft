# ---------------------------------------------------------------------------
# OSC (encode / decode / send / receive)
# ---------------------------------------------------------------------------

def _pad(data):
    return data + b"\0" * (-len(data) % 4)


def osc_encode(address, osc_type, value):
    """Encode a single-value VRChat OSC message."""
    if not isinstance(address, str) or not address.startswith("/"):
        raise ValueError("OSC address must start with /")
    out = _pad(address.encode("utf-8") + b"\0")
    if osc_type == "bool":
        out += _pad(b"," + (b"T" if value else b"F") + b"\0")
    elif osc_type == "int":
        out += _pad(b",i\0") + struct.pack(">i", int(value))
    elif osc_type == "float":
        out += _pad(b",f\0") + struct.pack(">f", float(value))
    elif osc_type == "string":
        out += _pad(b",s\0") + _pad(str(value).encode("utf-8") + b"\0")
    else:
        raise ValueError("unsupported OSC type: %r" % (osc_type,))
    return out


def _read_padded(data, offset):
    end = data.find(b"\0", offset)
    if end < 0:
        raise ValueError("unterminated string in OSC message")
    text = data[offset:end]
    offset = end + 1
    offset += -offset % 4
    return text, offset


def osc_decode(data):
    """Decode an OSC message -> (address, [(typetag, value), ...])."""
    if not data or not data.startswith(b"/"):
        raise ValueError("not an OSC message")
    address, offset = _read_padded(data, 0)
    tags, offset = _read_padded(data, offset)
    if not tags.startswith(b","):
        raise ValueError("OSC typetags must start with ,")
    values = []
    for tag in tags[1:].decode("ascii", "replace"):
        if tag == "T":
            values.append(("T", True))
        elif tag == "F":
            values.append(("F", False))
        elif tag == "N":
            values.append(("N", None))
        elif tag == "i":
            values.append(("i", struct.unpack_from(">i", data, offset)[0]))
            offset += 4
        elif tag == "f":
            values.append(("f", struct.unpack_from(">f", data, offset)[0]))
            offset += 4
        elif tag == "s":
            text, offset = _read_padded(data, offset)
            values.append(("s", text.decode("utf-8", "replace")))
        elif tag == "\0":
            break
        else:
            raise ValueError("unsupported OSC typetag: %r" % tag)
    return address.decode("utf-8", "replace"), values


class OscSender:
    """Fire-and-forget UDP sender."""

    def __init__(self, host="127.0.0.1", port=9000):
        self.host = host
        self.port = int(port)
        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sent = 0
        self.last_error = None

    def configure(self, host, port):
        self.host = host
        self.port = int(port)

    def send(self, address, osc_type, value):
        try:
            self._sock.sendto(
                osc_encode(address, osc_type, value), (self.host, self.port))
            self.sent += 1
            self.last_error = None
            return True
        except (OSError, ValueError, struct.error) as exc:
            self.last_error = str(exc)
            return False

    def close(self):
        try:
            self._sock.close()
        except OSError:
            pass


class OscListener(threading.Thread):
    """Receives VRChat OSC messages (default: 127.0.0.1:9001)."""

    def __init__(self, port, callback):
        super().__init__(daemon=True)
        self.port = int(port)
        self.callback = callback
        self.error = None
        # Thread._stop is a method used by join(); never shadow it.
        self._stop_event = threading.Event()
        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self._sock.settimeout(0.3)
        try:
            self._sock.bind(("", self.port))
        except OSError as exc:
            self.error = str(exc)
            self._sock.close()

    def run(self):
        if getattr(self._sock, "fileno", lambda: -1)() < 0:
            return
        while not self._stop_event.is_set():
            try:
                data, _addr = self._sock.recvfrom(65535)
            except socket.timeout:
                continue
            except OSError:
                break
            try:
                address, values = osc_decode(data)
            except ValueError:
                continue
            try:
                self.callback(address, values)
            except Exception:
                pass

    def close(self):
        self._stop_event.set()
        try:
            self._sock.close()
        except OSError:
            pass


