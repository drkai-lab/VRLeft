# diagnostics: --watch / --send / --selftest
# ---------------------------------------------------------------------------


def run_watch(seconds=None, scope=None):
    settings = load_settings()
    source = open_input_source(scope=scope or monitor_scope(settings))
    if source is None:
        print("no readable input node - check permissions / group membership",
              file=sys.stderr)
        return 1
    names = load_input_names()
    print("watching: %s" % source.describe())
    print("press a key or click a mouse button (Ctrl-C to stop)")
    deadline = time.time() + seconds if seconds else None
    try:
        while deadline is None or time.time() < deadline:
            try:
                events = source.wait(0.5)
            except (OSError, ValueError):
                break
            for event in events:
                if len(event) < 3:
                    continue
                etype, code, value = event[0], event[1], event[2]
                is_t1 = bool(event[3]) if len(event) > 3 else False
                if etype == EV_SYN:
                    continue
                kind, label = event_names(names, etype, code)
                if etype == EV_KEY:
                    state = "down" if value == 1 else ("up" if value == 0 else "repeat")
                else:
                    state = "%+d" % value
                print("  %-12s %-4s %-18s %-7s %s" % (
                    source.name, kind, label, state, "t1" if is_t1 else ""))
                sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        source.close()
    return 0


def run_send(address, osc_type, value):
    settings = load_settings()
    osc = settings.get("osc", {})
    if osc_type not in OSC_TYPES:
        print("type must be one of: %s" % ", ".join(OSC_TYPES), file=sys.stderr)
        return 1
    try:
        parsed = parse_value(osc_type, value)
    except ValueError as exc:
        print("bad value %r: %s" % (value, exc), file=sys.stderr)
        return 1
    sender = OscSender(osc.get("host", "127.0.0.1"), int(osc.get("port", 9000)))
    ok = sender.send(address, osc_type, parsed)
    sender.close()
    if not ok:
        print("send failed", file=sys.stderr)
        return 1
    print("sent %s %s = %s -> %s:%s" % (
        address, osc_type, format_value(parsed), osc.get("host"), osc.get("port")))
    return 0


def run_selftest(send_message=False):
    passed = []

    def check(label, ok, detail=""):
        passed.append(bool(ok))
        print("%-26s %-4s %s" % (label, "OK" if ok else "FAIL", detail))

    check("platform", True, "%s / python %s" % (sys.platform, sys.version.split()[0]))
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        writable = os.access(CONFIG_DIR, os.W_OK)
    except OSError:
        writable = False
    check("config file", writable, CONFIG_FILE)

    if IS_LINUX:
        nodes = list_input_nodes()
        t1_nodes = [path for path, _name, flag in nodes if flag]
        check("input nodes readable", bool(nodes),
              "%d nodes (T1: %s)" % (len(nodes), ",".join(t1_nodes) or "none"))
    else:
        source = open_input_source(scope="all")
        try:
            check("input source", source is not None,
                  source.describe() if source else "unavailable")
        finally:
            if source is not None:
                source.close()

    settings = load_settings()
    shift_keys = [b for b in settings.get("bindings", [])
                  if b.get("trigger", {}).get("kind") == "shift_digit"]
    check("shift+digit triggers", len(shift_keys) >= 10, "%d configured" % len(shift_keys))
    osc = settings.get("osc", {})
    check("osc target", True, "%s:%s" % (osc.get("host"), osc.get("port")))
    listener_ok = True
    detail = "port %s" % osc.get("listen_port")
    if osc.get("listen", True):
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            probe.bind(("", int(osc.get("listen_port", 9001))))
        except OSError as exc:
            listener_ok = False
            detail = str(exc)
        finally:
            probe.close()
    check("osc listener", listener_ok, detail)

    enabled = [b for b in settings.get("bindings", []) if b.get("enabled", True)]
    with_address = [b for b in enabled if (b.get("action", {}).get("address") or "").strip()]
    check("bindings", bool(settings.get("bindings")),
          "%d configured / %d enabled / %d with address" % (
              len(settings.get("bindings", [])), len(enabled), len(with_address)))

    if send_message:
        sender = OscSender(osc.get("host", "127.0.0.1"), int(osc.get("port", 9000)))
        ok = sender.send("/avatar/parameters/VRLeft_SelfTest", "bool", True)
        sender.close()
        check("test message", ok, "/avatar/parameters/VRLeft_SelfTest")

    ok = all(passed)
    print("\nRESULT: %s" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


