def default_settings():
    bindings = []
    number = 1
    for digit in (1, 2, 3, 4, 5, 6, 7, 8, 9, 0):
        bindings.append({
            "id": number,
            "enabled": False,
            "trigger": {"kind": "shift_digit", "digit": digit},
            "action": {
                "address": "", "type": "bool", "value": True,
                "off_value": False, "mode": "pulse", "pulse_ms": 200,
            },
        })
        number += 1
    return {
        "osc": {"host": "127.0.0.1", "port": 9000,
                "listen": True, "listen_port": 9001},
        "input": {"scope": "all", "shift_digits": True},
        "bindings": bindings,
    }


def load_settings():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return default_settings()
    if not isinstance(data, dict):
        return default_settings()
    settings = default_settings()
    for section in ("osc", "input"):
        incoming = data.get(section)
        if isinstance(incoming, dict):
            settings[section].update(incoming)
    if isinstance(data.get("bindings"), list):
        settings["bindings"] = data["bindings"]
    return settings


def save_settings(settings):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(settings, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, CONFIG_FILE)


def next_binding_id(settings):
    ids = [b.get("id", 0) for b in settings.get("bindings", [])]
    return max(ids + [0]) + 1


def find_binding(settings, binding_id):
    for binding in settings.get("bindings", []):
        if binding.get("id") == binding_id:
            return binding
    return None


def new_binding(settings, trigger):
    binding = {
        "id": next_binding_id(settings),
        "enabled": True,
        "trigger": trigger,
        "action": {
            "address": "/avatar/parameters/", "type": "bool", "value": True,
            "off_value": False, "mode": "pulse", "pulse_ms": 200,
        },
    }
    settings.setdefault("bindings", []).append(binding)
    return binding


def binding_label(binding):
    trigger = binding.get("trigger", {})
    if trigger.get("kind") == "shift_digit":
        return "Shift+%s" % trigger.get("digit")
    code = int(trigger.get("code", 0))
    name = EVDEV_KEY_NAMES.get((EV_KEY, code))
    if name is None:
        name = "0x%03x" % code
    device = trigger.get("device", "t1")
    return "%s%s" % (name, "" if device == "t1" else " (any)")

_MAC_LIBS = {}


def _mac():
    """Load IOKit / CoreFoundation and declare prototypes (macOS only)."""
    if _MAC_LIBS:
        return _MAC_LIBS
    cf = ctypes.CDLL(
        "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
    iohid = ctypes.CDLL(
        "/System/Library/Frameworks/IOKit.framework/IOKit")

    cfp, cfl = ctypes.c_void_p, ctypes.c_long
    cf.CFRelease.argtypes = [cfp]
    cf.CFStringCreateWithCString.restype = cfp
    cf.CFStringCreateWithCString.argtypes = [cfp, ctypes.c_char_p, cfl]
    cf.CFDictionaryCreate.restype = cfp
    cf.CFDictionaryCreate.argtypes = [
        cfp, ctypes.POINTER(cfp), ctypes.POINTER(cfp), cfl, cfp, cfp]
    cf.CFSetGetValues.argtypes = [cfp, ctypes.POINTER(cfp)]
    cf.CFSetGetCount.argtypes = [cfp]
    cf.CFSetGetCount.restype = cfl
    iohid.IOHIDManagerCreate.restype = cfp
    iohid.IOHIDManagerCreate.argtypes = [cfp, cfl]
    iohid.IOHIDManagerSetDeviceMatching.argtypes = [cfp, cfp]
    iohid.IOHIDManagerOpen.argtypes = [cfp, cfl]
    iohid.IOHIDManagerCopyDevices.restype = cfp
    iohid.IOHIDManagerCopyDevices.argtypes = [cfp]
    iohid.IOHIDDeviceOpen.argtypes = [cfp, cfl]
    iohid.IOHIDDeviceSetReport.argtypes = [
        cfp, cfl, cfl, ctypes.c_void_p, cfl]
    iohid.IOHIDDeviceSetReport.restype = cfl
    iohid.IOHIDDeviceCopyMatchingElements.restype = cfp
    iohid.IOHIDDeviceCopyMatchingElements.argtypes = [cfp, cfp, cfl]
    iohid.IOHIDElementGetReportID.argtypes = [cfp]
    iohid.IOHIDElementGetReportID.restype = cfl
    iohid.IOHIDElementGetType.argtypes = [cfp]
    iohid.IOHIDElementGetType.restype = cfl
    iohid.IOHIDElementGetReportSize.argtypes = [cfp]
    iohid.IOHIDElementGetReportSize.restype = cfl
    cf.CFRunLoopGetCurrent.argtypes = []
    cf.CFRunLoopGetCurrent.restype = cfp
    cf.CFRunLoopRunInMode.argtypes = [cfp, ctypes.c_double, ctypes.c_int]
    cf.CFRunLoopRunInMode.restype = cfl
    cf.CFNumberGetValue.argtypes = [cfp, cfl, ctypes.c_void_p]
    cf.CFNumberGetValue.restype = ctypes.c_int
    iohid.IOHIDManagerScheduleWithRunLoop.argtypes = [cfp, cfp, cfp]
    iohid.IOHIDManagerRegisterInputValueCallback.argtypes = [cfp, cfp, cfp]
