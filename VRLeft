            row.pack(fill="x", pady=(6, 0))
            ttk.Button(row, text="Clear", command=self.clear_log).pack(side="left")

        # -- bindings list --------------------------------------------------
        def _refresh_tree(self, keep=None):
            selected = keep if keep is not None else self.selected
            self.tree.delete(*self.tree.get_children())
            for binding in self.settings.get("bindings", []):
                label = binding_label(binding)
                action = binding.get("action", {})
                self.tree.insert("", "end", iid=str(binding.get("id")),
                                 values=(label, action.get("address", ""),
                                         action.get("type", "bool"),
                                         action.get("mode", "pulse"),
                                         "yes" if binding.get("enabled", True) else "no"))
            if selected is not None and self.tree.exists(str(selected)):
                self.tree.selection_set(str(selected))
                self._on_select()

        def _on_select(self, _event=None):
            selection = self.tree.selection()
            if not selection:
                return
            try:
                self.selected = int(selection[0])
            except ValueError:
                return
            binding = _id_binding(self.settings, self.selected)
            if binding is None:
                return
            trigger = binding.get("trigger", {})
            action = binding.get("action", {})
            self.vars["kind"].set(trigger.get("kind", "shift_digit"))
            self.vars["digit"].set(str(trigger.get("digit", 1)))
            self.vars["code"].set(str(trigger.get("code", "")))
            self.vars["device"].set(trigger.get("device", "t1"))
            self.vars["address"].set(str(action.get("address", "")))
            self.vars["type"].set(action.get("type", "bool"))
            self.vars["mode"].set(action.get("mode", "pulse"))
            self.vars["value"].set(format_value(action.get("value", True)))
            self.vars["off_value"].set(format_value(
                action.get("off_value", self._default_off(action))))
            self.vars["pulse_ms"].set(str(action.get("pulse_ms", 200)))
            self.vars["enabled"].set(bool(binding.get("enabled", True)))
            self._sync_trigger_form()
            self._sync_mode_form()

        @staticmethod
        def _default_off(action):
            osc_type = action.get("type", "bool")
            return {"int": 0, "float": 0.0, "string": ""}.get(osc_type, False)

        def _sync_trigger_form(self):
            kind = self.vars["kind"].get()
            shift = kind == "shift_digit"
            state = "readonly" if shift else "disabled"
            self.digit_box.configure(state=state)
            self.code_entry.configure(state="disabled" if shift else "normal")
            self.device_box.configure(state="disabled" if shift else "readonly")

        def _sync_mode_form(self):
            pulse = self.vars["mode"].get() == "pulse"
            state = "normal" if pulse else "disabled"
            self.pulse_entry.configure(state=state)

        def apply_form(self):
            binding = _id_binding(self.settings, self.selected)
            if binding is None:
                messagebox.showwarning("VRLeft", "Select a binding first")
                return
            action = binding.setdefault("action", {})
            try:
                osc_type = self.vars["type"].get()
                value = parse_value(osc_type, self.vars["value"].get())
                off_value = parse_value(osc_type, self.vars["off_value"].get())
                pulse_ms = int(self.vars["pulse_ms"].get() or 200)
            except ValueError as exc:
                messagebox.showerror("VRLeft", "Bad value: %s" % exc)
                return
            kind = self.vars["kind"].get()
            trigger = binding.setdefault("trigger", {})
            trigger["kind"] = kind
            if kind == "shift_digit":
                trigger["digit"] = int(self.vars["digit"].get())
                trigger.pop("code", None)
                trigger.pop("device", None)
            else:
                trigger["code"] = int(self.vars["code"].get())
                trigger["device"] = self.vars["device"].get() or "any"
                trigger.pop("digit", None)
            action["address"] = self.vars["address"].get().strip()
            action["type"] = osc_type
            action["value"] = value
            action["off_value"] = off_value
            action["mode"] = self.vars["mode"].get()
            action["pulse_ms"] = pulse_ms
            binding["enabled"] = bool(self.vars["enabled"].get())
            self._refresh_tree(keep=self.selected)
            self.save(refresh=False)

        def new_binding(self):
            kind = self.vars["kind"].get() or "shift_digit"
            if kind == "shift_digit":
                digits = {b.get("trigger", {}).get("digit")
                          for b in self.settings.get("bindings", [])
                          if b.get("trigger", {}).get("kind") == "shift_digit"}
                digit = next((d for d in (1, 2, 3, 4, 5, 6, 7, 8, 9, 0)
                              if d not in digits), 1)
                trigger = {"kind": "shift_digit", "digit": digit}
            else:
                trigger = {"kind": "key", "code": 0, "device": "any"}
            binding = new_binding(self.settings, trigger)
            self.selected = binding["id"]
            self._refresh_tree(keep=self.selected)
            self._on_select()
            self.save(refresh=False)

        def delete_binding(self):
            if self.selected is None:
                return
            if not messagebox.askyesno("VRLeft", "Delete this binding?"):
                return
            self.settings["bindings"] = [
                b for b in self.settings.get("bindings", [])
                if b.get("id") != self.selected]
            self.selected = None
            self._refresh_tree()
            self.save(refresh=False)

        # -- actions --------------------------------------------------------
        def save(self, refresh=True):
            try:
                save_settings(self.settings)
            except OSError as exc:
                messagebox.showerror("VRLeft", "Save failed: %s" % exc)
                return
            engine = self.shared.get("engine")
            if engine is not None:
                engine.refresh(self.settings)
            if refresh:
                self.status_var.set("saved %s" % time.strftime("%H:%M:%S"))

        def reload(self):
            self.settings = load_settings()
            self.selected = None
            self._refresh_tree()
            engine = self.shared.get("engine")
            if engine is not None:
                engine.refresh(self.settings)
            self.status_var.set("reloaded")

        def send_test(self):
            osc = self.settings.get("osc", {})
            sender = OscSender(osc.get("host", "127.0.0.1"), int(osc.get("port", 9000)))
            ok = sender.send("/avatar/parameters/VRLeft_SelfTest", "bool", True)
            error = sender.last_error
            sender.close()
            if ok:
                self.outbox.put("test message sent "
                                "(/avatar/parameters/VRLeft_SelfTest = true)")
            else:
                self.outbox.put("test message failed: %s" % error)

        def refresh_devices(self):
            self.devices.delete(0, "end")
            if not IS_LINUX:
                self.devices.insert("end", "(device list is Linux only)")
                return
            nodes = list_input_nodes()
            if not nodes:
                self.devices.insert("end", "(no readable input nodes - check "
                                           "permissions)")
            for path, name, is_t1 in nodes:
                self.devices.insert(
                    "end", "%s  %s  %s" % (path, name, "[T1]" if is_t1 else ""))

        def detect_key(self):
            scope = self.vars["scope"].get() or monitor_scope(self.settings)
            window = tk.Toplevel(self.root)
            window.title("Detect key")
            window.transient(self.root)
            window.grab_set()
            message = tk.StringVar(value="Press a key on the target device (5s)")
            ttk.Label(window, textvariable=message, padding=16).pack()
            source = open_input_source(scope=scope)
            if source is None:
                message.set("No input source available")
            deadline = time.time() + 5.0

            def poll():
                if source is not None:
                    for event in source.wait(0.05):
                        if len(event) < 3:
                            continue
                        etype, code, value = event[0], event[1], event[2]
                        is_t1 = bool(event[3]) if len(event) > 3 else False
                        if etype == EV_KEY and value == 1 and code not in SHIFT_CODES:
                            self.vars["kind"].set("key")
                            self.vars["code"].set(str(code))
                            self.vars["device"].set("t1" if is_t1 else "any")
                            self._sync_trigger_form()
                            if source is not None:
                                source.close()
                            window.destroy()
                            return
                if time.time() >= deadline:
                    if source is not None:
                        source.close()
                    window.destroy()
                    return
                window.after(40, poll)

            window.after(40, poll)

        def toggle_monitor(self):
            if self.monitor_thread is not None and self.monitor_thread.is_alive():
                self.stop_event.set()
                self.monitor_button.configure(text="Start monitor")
                return
            self.stop_event = threading.Event()
            self.save(refresh=False)
            settings = self.settings

            def emit(line):
                self.outbox.put(line)

            def target():
                monitor_loop(settings, stop_event=self.stop_event, emit=emit,
                             shared=self.shared)

            self.monitor_thread = threading.Thread(target=target, daemon=True)
            self.monitor_thread.start()
            self.monitor_button.configure(text="Stop monitor")

        def clear_log(self):
            self.log_text.configure(state="normal")
            self.log_text.delete("1.0", "end")
            self.log_text.configure(state="disabled")

        def _poll(self):
            drained = 0
            while drained < 50:
                try:
                    line = self.outbox.get_nowait()
                except queue.Empty:
                    break
                drained += 1
                self.log_text.configure(state="normal")
                self.log_text.insert("end", line + "\n")
                self.log_text.see("end")
                self.log_text.configure(state="disabled")
            engine = self.shared.get("engine")
            if engine is not None:
                self.status_var.set(
                    "monitor on - %d sent, %d skipped" % (engine.sent, engine.skipped))
            elif self.status_var.get().startswith("monitor on"):
                self.status_var.set("stopped")
            self.root.after(150, self._poll)

        def on_close(self):
            self.stop_event.set()
            self.root.destroy()

    root = tk.Tk()
    MainWindow(root)
    if os.environ.get("VRLEFT_GUI_SMOKE"):
        root.update_idletasks()
        root.update()
        root.destroy()
        return 0
    root.mainloop()
    return 0


# ---------------------------------------------------------------------------
# entry point
# ---------------------------------------------------------------------------


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="VRLeft",
        description="Trigger VRChat avatar parameters from a keypad "
                    "(T1 mini keyboard or Shift+1..0).")
    parser.add_argument("--version", action="store_true",
                        help="print the version and exit")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--gui", action="store_true", help="open the settings GUI")
    group.add_argument("--monitor", action="store_true",
                       help="run the input -> OSC monitor in the foreground")
    group.add_argument("--watch", nargs="?", const=0, type=int, default=None,
                       metavar="SECONDS", help="print incoming input events")
    group.add_argument("--selftest", action="store_true",
                       help="check configuration and hardware, then exit")
    parser.add_argument("--send", nargs=3, metavar=("ADDRESS", "TYPE", "VALUE"),
                        help="send one OSC message and exit")
    parser.add_argument("--scope", choices=("all", "t1"), default=None,
                        help="input device scope for --watch")
    parser.add_argument("--send-test", action="store_true",
                        help="with --selftest: send a test message to VRChat")
    args = parser.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0
    if args.send:
        return run_send(*args.send)
    if args.selftest:
        return run_selftest(send_message=args.send_test)
    if args.watch is not None:
        return run_watch(seconds=args.watch or None, scope=args.scope)
    if args.monitor:
        return run_monitor()
    if args.gui:
        return run_gui()
    try:
        import tkinter  # noqa: F401
    except Exception:
        return run_monitor()
    return run_gui()


if __name__ == "__main__":
    sys.exit(main())
