EVDEV_KEY_NAMES = build_input_names()

def load_input_names():
    """{(evtype, code): name}, preferring the kernel header when present."""
    names = {}
    try:
        lines = open(INPUT_CODES, encoding="utf-8", errors="replace")
    except OSError:
        lines = None
    if lines is not None:
        pattern = re.compile(r"^\s*#define\s+((?:KEY|BTN|REL|ABS)_[A-Z0-9_]+)\s+(\d+)")
        with lines:
            for line in lines:
                match = pattern.match(line)
                if match:
                    name = match.group(1)
                    etype = (EV_REL if name.startswith("REL_") else
                             3 if name.startswith("ABS_") else EV_KEY)
                    names.setdefault((etype, int(match.group(2))), name)
    for key, name in EVDEV_KEY_NAMES.items():
        names.setdefault(key, name)
    return names


def event_names(names, etype, code):
    label = names.get((etype, code))
    if label is None:
        label = "0x%03x" % code
    kind = {EV_KEY: "KEY", EV_REL: "REL", 3: "ABS", 4: "MSC"}.get(
        etype, "EV%d" % etype)
    return kind, label

class InputSource:
    """Reads T1 input events and normalises them to (etype, code, value)."""

    name = "input"

    def wait(self, timeout):
        """Return the events seen within timeout seconds."""
        raise NotImplementedError

    def describe(self):
        return self.name

    def close(self):
        pass


class LinuxInputSource(InputSource):
    """evdev nodes: the T1 only (scope="t1") or every input node (scope="all")."""

    def __init__(self, scope="all"):
        self.scope = scope
        self.fds = open_input_nodes(only_t1=(scope == "t1"))
        if not self.fds:
            raise DeviceError("no readable input node")
        self._t1_flag = {fd: flag for fd, _path, flag in self.fds}
        self.name = ", ".join(os.path.basename(path) for _fd, path, _f in self.fds)

    def wait(self, timeout):
        ready, _, _ = select.select([fd for fd, _p, _f in self.fds], [], [], timeout)
        events = []
        for fd in ready:
            is_t1 = self._t1_flag[fd]
            events.extend([event + (is_t1,) for event in read_events(fd)])
        return events

    def close(self):
        for fd, _path, _flag in self.fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds = []


class QueueInputSource(InputSource):
    """Shared helper: events are pushed by a backend thread."""

    def __init__(self):
        self._queue = queue.Queue()
        self._stop = threading.Event()
        self.name = "input"

    def _push(self, event):
        self._queue.put(event)

    def wait(self, timeout):
        events = []
        deadline = time.time() + max(0.0, timeout)
        while True:
            try:
                events.append(self._queue.get(timeout=max(0.0, deadline - time.time())))
            except queue.Empty:
                break
            if time.time() >= deadline:
                break
        return events

    def close(self):
        self._stop.set()


class WindowsInputSource(QueueInputSource):
    """Raw input (WM_INPUT) filtered to the T1, mapped to evdev codes."""

    RIDEV_INPUTSINK = 0x00000100
    WM_INPUT = 0x00FF
    RI_KEY_BREAK = 0x0001
    RID_INPUT = 1
    RIDI_DEVICENAME = 1

    def __init__(self, scope="all"):
        super().__init__()
        self.scope = scope
        self.name = "raw-input"
        self._current_is_t1 = False
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _push(self, event):
        super()._push(event + (self._current_is_t1,))

    def _run(self):
        try:
            self._message_loop()
        except Exception:
            log("windows input backend failed: %s" % sys.exc_info()[1])

    def _message_loop(self):
        import ctypes.wintypes as wt

        user32 = ctypes.WinDLL("user32", use_last_error=True)
        self._user32 = user32

        class WNDCLASSEXW(ctypes.Structure):
            _fields_ = [
                ("cbSize", ctypes.c_uint), ("style", ctypes.c_uint),
                ("lpfnWndProc", ctypes.c_void_p), ("cbClsExtra", ctypes.c_int),
                ("cbWndExtra", ctypes.c_int), ("hInstance", ctypes.c_void_p),
                ("hIcon", ctypes.c_void_p), ("hCursor", ctypes.c_void_p),
                ("hbrBackground", ctypes.c_void_p), ("lpszMenuName", wt.LPCWSTR),
                ("lpszClassName", wt.LPCWSTR), ("hIconSm", ctypes.c_void_p),
            ]

        class RAWINPUTDEVICE(ctypes.Structure):
            _fields_ = [("wUsagePage", ctypes.c_ushort), ("wUsage", ctypes.c_ushort),
                        ("dwFlags", ctypes.c_uint), ("hwndTarget", ctypes.c_void_p)]

        WNDPROC = ctypes.WINFUNCTYPE(ctypes.c_long, ctypes.c_void_p, ctypes.c_uint,
                                     ctypes.c_wparam, ctypes.c_lparam)
        user32.DefWindowProcW.argtypes = [ctypes.c_void_p, ctypes.c_uint,
                                          ctypes.c_wparam, ctypes.c_lparam]
        user32.DefWindowProcW.restype = ctypes.c_long

        def wnd_proc(hwnd, msg, wparam, lparam):
            if msg == self.WM_INPUT:
                self._on_raw_input(user32, wparam, lparam)
                return 0
            return user32.DefWindowProcW(hwnd, msg, wparam, lparam)

        self._wnd_proc = WNDPROC(wnd_proc)
        wndclass = WNDCLASSEXW()
        wndclass.cbSize = ctypes.sizeof(WNDCLASSEXW)
        wndclass.lpfnWndProc = ctypes.cast(self._wnd_proc, ctypes.c_void_p)
        wndclass.lpszClassName = "VRLeftRawInput"
        if not user32.RegisterClassExW(ctypes.byref(wndclass)):
            return
        hwnd = user32.CreateWindowExW(
            0, wndclass.lpszClassName, "VRLeft", 0, 0, 0, 0, 0,
            -3, None, None, None)  # HWND_MESSAGE window
        if not hwnd:
            return
        devices = (RAWINPUTDEVICE * 2)(
            RAWINPUTDEVICE(0x01, 0x06, self.RIDEV_INPUTSINK, hwnd),
            RAWINPUTDEVICE(0x01, 0x02, self.RIDEV_INPUTSINK, hwnd))
        if not user32.RegisterRawInputDevices(devices, 2, ctypes.sizeof(RAWINPUTDEVICE)):
            user32.DestroyWindow(hwnd)
            return
        msg = wt.MSG()
        while not self._stop.is_set():
            result = user32.GetMessageW(ctypes.byref(msg), None, 0, 0)
            if result in (0, -1):
                break
            user32.TranslateMessage(ctypes.byref(msg))
            user32.DispatchMessageW(ctypes.byref(msg))
        user32.DestroyWindow(hwnd)

    def _on_raw_input(self, user32, wparam, lparam):
        import ctypes.wintypes as wt

        class RAWINPUTHEADER(ctypes.Structure):
            _fields_ = [("dwType", ctypes.c_uint), ("dwSize", ctypes.c_uint),
                        ("hDevice", ctypes.c_void_p), ("wParam", ctypes.c_wparam)]

        size = wt.UINT(0)
        user32.GetRawInputData(lparam, self.RID_INPUT, None, ctypes.byref(size),
                               ctypes.sizeof(RAWINPUTHEADER))
        if not size.value:
            return
        buf = ctypes.create_string_buffer(size.value)
        if user32.GetRawInputData(lparam, self.RID_INPUT, buf, ctypes.byref(size),
                                  ctypes.sizeof(RAWINPUTHEADER)) < 0:
            return
        header = ctypes.cast(buf, ctypes.POINTER(RAWINPUTHEADER)).contents
        is_t1 = self._is_t1_device(user32, header.hDevice)
        if self.scope == "t1" and not is_t1:
            return
        self._current_is_t1 = is_t1
        body = ctypes.addressof(buf) + ctypes.sizeof(RAWINPUTHEADER)
        if header.dwType == 0:  # RIM_TYPEKEYBOARD
            flags = ctypes.c_ushort.from_address(body + 2).value
            vkey = ctypes.c_ushort.from_address(body + 4).value
            code = VK_TO_EVDEV.get(vkey)
            if code is None:
                return
            self._push((EV_KEY, code, 0 if flags & self.RI_KEY_BREAK else 1))
        elif header.dwType == 1:  # RIM_TYPEMOUSE
            button_flags = ctypes.c_ushort.from_address(body + 4).value
            button_data = ctypes.c_short.from_address(body + 6).value
            self._push_mouse(button_flags, button_data)

    def _push_mouse(self, flags, data):
        for bit, code in ((0x0001, 272), (0x0004, 273), (0x0010, 274)):
            if flags & bit:
                self._push((EV_KEY, code, 1))
            if flags & (bit << 1):
                self._push((EV_KEY, code, 0))
        if flags & 0x0400:  # RI_MOUSE_WHEEL
            self._push((EV_REL, 8, 1 if data > 0 else -1))
        if flags & 0x0800:  # RI_MOUSE_HWHEEL
            self._push((EV_REL, 6, 1 if data > 0 else -1))

    def _is_t1_device(self, user32, hdevice):
        if not hdevice:
            return False
        if not hasattr(self, "_t1_devices"):
            self._t1_devices = {}
        known = self._t1_devices.get(hdevice)
        if known is not None:
            return known
        import ctypes.wintypes as wt

        length = wt.UINT(0)
        user32.GetRawInputDeviceInfoW(hdevice, self.RIDI_DEVICENAME, None,
                                      ctypes.byref(length))
        if not length.value:
            return False
        buf = ctypes.create_string_buffer((length.value + 1) * 2)
        if user32.GetRawInputDeviceInfoW(hdevice, self.RIDI_DEVICENAME, buf,
                                         ctypes.byref(length)) < 0:
            return False
        path = buf.value.decode("utf-16", "replace").lower()
        found = "vid_1189" in path and "pid_8890" in path
        if len(self._t1_devices) < 32:
            self._t1_devices[hdevice] = found
        return found


class MacInputSource(QueueInputSource):
    """IOHID input value callbacks mapped to evdev codes."""

    def __init__(self, scope="all"):
        super().__init__()
        self.scope = scope
        self.name = "IOHIDDevice"
        self._device_cache = {}
        self._current_is_t1 = False
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _push(self, event):
        super()._push(event + (self._current_is_t1,))

    def _device_is_t1(self, device):
        """VendorID/ProductID lookup for one IOHIDDeviceRef (cached)."""
        if not device:
            return False
        cached = self._device_cache.get(device)
        if cached is not None:
            return cached
        result = False
        try:
            iohid = _mac()["iohid"]
            ok = True
            for key, expected in (("VendorID", VID), ("ProductID", PID)):
                prop = iohid.IOHIDDeviceGetProperty(device, _cf_string(key))
                if not prop:
                    ok = False
                    break
                number = ctypes.c_int(0)
                if not _mac()["cf"].CFNumberGetValue(prop, 3, ctypes.byref(number)):
                    ok = False
                    break
                _cf_release(prop)
                if number.value != expected:
                    ok = False
                    break
            result = ok
        except Exception:
            result = False
        if len(self._device_cache) < 64:
            self._device_cache[device] = result
        return result

    def _run(self):
        try:
            self._register()
        except Exception:
            log("macos input backend failed: %s" % sys.exc_info()[1])

    def _register(self):

        libs = _mac()
        cf, iohid = libs["cf"], libs["iohid"]
        if not hasattr(iohid, "IOHIDManagerRegisterInputValueCallback"):
            return
        manager = iohid.IOHIDManagerCreate(None, 0)
        if not manager:
            return
        match = None
        if self.scope == "t1":
            match = _cf_dict([("VendorID", "%d" % VID), ("ProductID", "%d" % PID)])
        iohid.IOHIDManagerSetDeviceMatching(manager, match)
        callback_type = ctypes.CFUNCTYPE(
            None, ctypes.c_void_p, ctypes.c_long, ctypes.c_void_p, ctypes.c_void_p)
        self._callback = callback_type(self._on_input)
        iohid.IOHIDManagerRegisterInputValueCallback(manager, self._callback, None)
        iohid.IOHIDManagerOpen(manager, 0)
        run_loop = cf.CFRunLoopGetCurrent()
        mode = None
        release_mode = True
        try:
            mode = ctypes.c_void_p.in_dll(cf, "kCFRunLoopDefaultMode").value
            release_mode = False  # global constant, not ours to release
        except (ValueError, TypeError):
            mode = None
        if not mode:
            mode = cf.CFStringCreateWithCString(
                None, b"kCFRunLoopDefaultMode", 0x08000100)
        iohid.IOHIDManagerScheduleWithRunLoop(manager, run_loop, mode)
        while not self._stop.is_set():
            cf.CFRunLoopRunInMode(mode, 0.25, 0)
        if release_mode:
            _cf_release(mode)

    def _on_input(self, _context, _result, sender, _value):
        try:
            self._current_is_t1 = self._device_is_t1(sender)
            libs = _mac()
            iohid = libs["iohid"]
            usage_page = int(iohid.IOHIDValueGetUsagePage(_value))
            usage = int(iohid.IOHIDValueGetUsage(_value))
            number = int(iohid.IOHIDValueGetIntegerValue(_value))
            if usage_page == 0x07:
                code = HID_USAGE_TO_EVDEV.get(usage)
                if code is None:
                    return
                self._push((EV_KEY, code, 1 if number else 0))
            elif usage_page == 0x0C:
                code = CONSUMER_TO_EVDEV.get(usage)
                if code is not None:
                    self._push((EV_KEY, code, 1 if number else 0))
            elif usage_page == 0x01:
                if usage == 0x38:  # wheel
                    self._push((EV_REL, 8, 1 if number > 0 else (-1 if number else 0)))
                elif usage == 0x36:  # AC pan / horizontal wheel
                    self._push((EV_REL, 6, 1 if number > 0 else (-1 if number else 0)))
                elif usage in (0x09, 0x0A, 0x0B):
                    self._push((EV_KEY, {0x09: 272, 0x0A: 273, 0x0B: 274}[usage],
                                1 if number else 0))
        except Exception:
            pass

def open_input_source(scope="all"):
    """Best available input source on this platform (None when unavailable)."""
    try:
        if IS_WIN:
            return WindowsInputSource(scope=scope)
        if IS_MAC:
            return MacInputSource(scope=scope)
        return LinuxInputSource(scope=scope)
    except DeviceError:
        return None
    except Exception:
        return None

# ---------------------------------------------------------------------------
# trigger engine: input events -> OSC messages
# ---------------------------------------------------------------------------


def parse_value(osc_type, text):
    """Convert a GUI/CLI string into the value for an OSC type."""
    text = str(text).strip()
    if osc_type == "bool":
        return text.lower() in ("1", "true", "t", "yes", "on")
    if osc_type == "int":
        return int(text, 0)
    if osc_type == "float":
        return float(text)
    return text


def format_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float):
        return "%g" % value
    if isinstance(value, str):
        return value
    return str(value)


class Engine:
    """Turns (etype, code, value, is_t1) input events into OSC messages."""

    def __init__(self, settings, sender, emit=None, now=None):
        self.settings = settings
        self.sender = sender
        self.emit = emit or (lambda line: None)
        self._now = now or time.time
        self.shift = False
        self.toggle = {}
        self.held = set()
        self.pulses = []
        self.sent = 0
        self.skipped = 0

    def refresh(self, settings):
        """Point the engine at a new settings object (GUI saves in place)."""
        self.settings = settings

    # -- matching -----------------------------------------------------------
    def _matches(self, binding, kind, digit=None, code=None, is_t1=False):
        trigger = binding.get("trigger", {})
        if trigger.get("kind") != kind:
            return False
        if kind == "shift_digit":
            return trigger.get("digit") == digit
        if int(trigger.get("code", -1)) != code:
            return False
        if trigger.get("device", "t1") == "t1" and not is_t1:
            return False
        return True

    def _select(self, kind, **kwargs):
        for binding in self.settings.get("bindings", []):
            if not binding.get("enabled", True):
                continue
            if self._matches(binding, kind, **kwargs):
                yield binding

    # -- sending ------------------------------------------------------------
    def _send(self, address, osc_type, value):
        if not self.sender.send(address, osc_type, value):
            self.emit("send failed %s: %s" % (address, self.sender.last_error))
            return []
        self.sent += 1
        self.emit("%s %s = %s" % (address, osc_type, format_value(value)))
        return [(address, value)]

    def _off_value(self, action):
        if "off_value" in action:
            return action["off_value"]
        osc_type = action.get("type", "bool")
        if osc_type == "int":
            return 0
        if osc_type == "float":
            return 0.0
        if osc_type == "string":
            return ""
        return False

    def _send_action(self, action, value):
        address = (action.get("address") or "").strip()
        if not address:
            self.skipped += 1
            return []
        return self._send(address, action.get("type", "bool"), value)

    def _fire(self, binding):
        action = binding.get("action", {})
        mode = action.get("mode", "pulse")
        binding_id = binding.get("id")
        if mode == "toggle":
            state = not self.toggle.get(binding_id, False)
            self.toggle[binding_id] = state
            value = action.get("value", True) if state else self._off_value(action)
            return self._send_action(action, value)
        if mode == "pulse":
            sent = self._send_action(action, action.get("value", True))
            if sent:
                delay = max(1, int(action.get("pulse_ms", 200))) / 1000.0
                self.pulses.append((self._now() + delay, binding_id, action))
            return sent
        if mode == "hold":
            if binding_id in self.held:
                return []
            self.held.add(binding_id)
        return self._send_action(action, action.get("value", True))

    def _send_off(self, binding):
        action = binding.get("action", {})
        return self._send_action(action, self._off_value(action))

    def _release(self, binding):
        binding_id = binding.get("id")
        if binding_id not in self.held:
            return []
        self.held.discard(binding_id)
        return self._send_off(binding)

    # -- events -------------------------------------------------------------
    def handle(self, event):
        if len(event) < 3:
            return []
        etype, code, value = event[0], event[1], event[2]
        is_t1 = bool(event[3]) if len(event) > 3 else True
        if etype != EV_KEY:
            return []
        sent = []
        if code in SHIFT_CODES:
            if value and not self.shift:
                self.shift = True
            elif not value and self.shift:
                self.shift = False
                for binding in list(self.held):
                    held = _id_binding(self.settings, binding)
                    if held and held.get("trigger", {}).get("kind") == "shift_digit":
                        sent.extend(self._release(held))
            return sent
        if value == 0:
            for binding in list(self._select("key", code=code, is_t1=is_t1)):
                sent.extend(self._release(binding))
            return sent
        if value != 1:
            return []  # key repeat
        if self.shift and self.settings.get("input", {}).get("shift_digits", True):
            digit = DIGIT_CODES.get(code)
            if digit is not None:
                for binding in self._select("shift_digit", digit=digit):
                    sent.extend(self._fire(binding))
        for binding in self._select("key", code=code, is_t1=is_t1):
            sent.extend(self._fire(binding))
        return sent

    def tick(self):
        """Fire the release half of finished pulses."""
        now = self._now()
        due = [entry for entry in self.pulses if entry[0] <= now]
        if not due:
            return []
        self.pulses = [entry for entry in self.pulses if entry[0] > now]
        sent = []
        for _deadline, _binding_id, action in due:
            sent.extend(self._send_action(action, self._off_value(action)))
        return sent


def _id_binding(settings, binding_id):
    for binding in settings.get("bindings", []):
        if binding.get("id") == binding_id:
            return binding
    return None


# ---------------------------------------------------------------------------
# monitor loop
# ---------------------------------------------------------------------------


def monitor_scope(settings):
    """Devices to listen to: everything when Shift+digit is used."""
    input_cfg = settings.get("input", {})
    if input_cfg.get("shift_digits", True):
        return "all"
    for binding in settings.get("bindings", []):
        trigger = binding.get("trigger", {})
        if trigger.get("kind") == "key" and trigger.get("device", "t1") == "any":
            return "all"
    return "t1"


def monitor_loop(settings, stop_event=None, emit=None, shared=None):
    """Input events -> engine -> VRChat. Returns when stop_event is set."""
    stop_event = stop_event or threading.Event()
    emit = emit or (lambda line: print(line, flush=True))
    osc = settings.get("osc", {})
    sender = OscSender(osc.get("host", "127.0.0.1"), int(osc.get("port", 9000)))
    engine = Engine(settings, sender, emit=emit)
    if shared is not None:
        shared["engine"] = engine
    inbox = queue.Queue()
    listener = None
    if osc.get("listen", True):
        listener = OscListener(int(osc.get("listen_port", 9001)),
                               lambda address, values: inbox.put((address, values)))
        if listener.error:
            emit("listener unavailable: %s" % listener.error)
            listener = None
        else:
            listener.start()
    scope = monitor_scope(settings)
    source = open_input_source(scope=scope)
    if source is None:
        emit("input source unavailable (scope=%s) - Shift+digit will not fire" % scope)
    else:
        emit("input: %s (scope=%s)" % (source.describe(), scope))
    emit("osc: sending to %s:%s" % (sender.host, sender.port))
    mtime = _config_mtime()
    try:
        while not stop_event.is_set():
            if source is not None:
                try:
                    for event in source.wait(0.15):
                        engine.handle(event)
                except (OSError, ValueError) as exc:
                    emit("input read error: %s" % exc)
                    stop_event.wait(0.5)
            engine.tick()
            while True:
                try:
                    address, values = inbox.get_nowait()
                except queue.Empty:
                    break
                emit("recv %s %s" % (address, values))
            if shared is None:
                new_mtime = _config_mtime()
                if new_mtime != mtime:
                    mtime = new_mtime
                    fresh = load_settings()
                    settings.clear()
                    settings.update(fresh)
                    engine.refresh(settings)
                    emit("settings reloaded")
    finally:
        if listener is not None:
            listener.close()
        if source is not None:
            source.close()
        sender.close()
        if shared is not None:
            shared.pop("engine", None)
        emit("monitor stopped")


def _config_mtime():
    try:
        return os.stat(CONFIG_FILE).st_mtime_ns
    except OSError:
        return 0


def _pid_alive(pid):
    if IS_WIN:
        result = subprocess.run(
            ["tasklist", "/FI", "PID eq %d" % pid], capture_output=True, text=True)
        return str(pid) in result.stdout
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def run_monitor(_argv=None):
    pid_path = pid_file_path()
    try:
        pid = int(open(pid_path, encoding="utf-8").read().strip())
    except (OSError, ValueError):
        pid = 0
    if pid and pid != os.getpid() and _pid_alive(pid):
        log("monitor already running (pid %d)" % pid)
        return 1
    write_pid_file()
    stop = threading.Event()

    def _stop(_signum, _frame):
        stop.set()

    for signame in ("SIGTERM", "SIGINT"):
        if hasattr(signal, signame):
            signal.signal(getattr(signal, signame), _stop)
    settings = load_settings()
    log("monitor starting (pid %d)" % os.getpid())
    try:
        monitor_loop(settings, stop_event=stop, emit=log)
    finally:
        remove_pid_file()
        log("monitor exiting")
    return 0


