    iohid.IOHIDDeviceGetProperty.restype = cfp

    _MAC_LIBS.update({"cf": cf, "iohid": iohid})
    return _MAC_LIBS


def _cf_string(text):
    libs = _mac()
    return libs["cf"].CFStringCreateWithCString(
        None, text.encode("utf-8"), 0x08000100)


def _cf_dict(pairs):
    """Small CFDictionary with CFType callbacks (resolved from the library)."""
    libs = _mac()
    cf = libs["cf"]
    keys = (ctypes.c_void_p * len(pairs))()
    values = (ctypes.c_void_p * len(pairs))()
    for index, (key, value) in enumerate(pairs):
        keys[index] = _cf_string(key)
        values[index] = _cf_string(value)
    key_cb = ctypes.c_void_p.in_dll(cf, "kCFTypeDictionaryKeyCallBacks")
    val_cb = ctypes.c_void_p.in_dll(cf, "kCFTypeDictionaryValueCallBacks")
    return cf.CFDictionaryCreate(
        None, keys, values, len(pairs),
        ctypes.addressof(key_cb), ctypes.addressof(val_cb))


def _cf_release(ref):
    if ref:
        try:
            _mac()["cf"].CFRelease(ref)
        except Exception:
            pass

EV_SYN, EV_KEY, EV_REL = 0x1, 0x2, 0x3
INPUT_EVENT = struct.Struct("llHHi")

def list_input_nodes(only_t1=False):
    """Every readable /dev/input/event* node, with its T1 flag."""
    nodes = []
    for uevent in glob.glob("/sys/class/input/event*/device/uevent"):
        try:
            text = open(uevent, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        product = ""
        name = ""
        for line in text.splitlines():
            if line.startswith("PRODUCT="):
                product = line.split("=", 1)[1].strip()
            elif line.startswith("NAME="):
                name = line.split("=", 1)[1].strip().strip('"')
        parts = product.split("/")
        is_t1 = False
        if len(parts) >= 3:
            try:
                is_t1 = int(parts[1], 16) == VID and int(parts[2], 16) == PID
            except ValueError:
                is_t1 = False
        if only_t1 and not is_t1:
            continue
        event = "/dev/input/" + os.path.basename(
            os.path.dirname(os.path.dirname(uevent)))
        nodes.append((event, name, is_t1))
    nodes.sort()
    return nodes


def open_input_nodes(only_t1=False):
    fds = []
    for path, _name, is_t1 in list_input_nodes(only_t1=only_t1):
        try:
            flags = os.O_RDONLY | os.O_NONBLOCK
            fds.append((os.open(path, flags), path, is_t1))
        except OSError:
            continue
    return fds


def read_events(fd):
    out = []
    while True:
        try:
            raw = os.read(fd, INPUT_EVENT.size)
        except BlockingIOError:
            break
        except OSError:
            break
        if len(raw) < INPUT_EVENT.size:
            break
        _sec, _usec, etype, code, value = INPUT_EVENT.unpack(raw)
        out.append((etype, code, value))
    return out


