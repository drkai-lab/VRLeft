def build_input_names():
    """{(evtype, code): name} used by --watch when the kernel header is absent.

    Codes repeat across event types (6 is both KEY_5 and REL_HWHEEL), so the
    event type is part of the key.
    """
    names = {}

    def add(etype, code, name):
        names[(etype, code)] = name

    for etype, code, name in (
            (EV_REL, 6, "REL_HWHEEL"), (EV_REL, 7, "REL_DIAL"),
            (EV_REL, 8, "REL_WHEEL"), (EV_REL, 11, "REL_WHEEL_HI_RES"),
            (EV_REL, 12, "REL_HWHEEL_HI_RES"),
            (EV_KEY, 272, "BTN_LEFT"), (EV_KEY, 273, "BTN_RIGHT"),
            (EV_KEY, 274, "BTN_MIDDLE"),
            (EV_KEY, 113, "KEY_MUTE"), (EV_KEY, 114, "KEY_VOLUMEUP"),
            (EV_KEY, 115, "KEY_VOLUMEDOWN"), (EV_KEY, 164, "KEY_PLAYPAUSE"),
            (EV_KEY, 165, "KEY_STOPCD"), (EV_KEY, 166, "KEY_PREVIOUSSONG"),
            (EV_KEY, 167, "KEY_NEXTSONG")):
        add(etype, code, name)

    letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    for index, code in enumerate([30, 48, 46, 32, 18, 33, 34, 35, 23, 36,
                                  37, 38, 50, 49, 24, 25, 16, 19, 31, 20,
                                  22, 47, 17, 45, 21, 44]):
        add(EV_KEY, code, "KEY_" + letters[index])
    for index in range(9):
        add(EV_KEY, 2 + index, "KEY_%d" % (index + 1))
    add(EV_KEY, 11, "KEY_0")
    for index in range(12):
        add(EV_KEY, 59 + index if index < 10 else (87, 88)[index - 10],
            "KEY_F%d" % (index + 1))
    for code, name in (
            (1, "KEY_ESC"), (14, "KEY_BACKSPACE"), (15, "KEY_TAB"),
            (28, "KEY_ENTER"), (29, "KEY_LEFTCTRL"), (42, "KEY_LEFTSHIFT"),
            (54, "KEY_RIGHTSHIFT"), (56, "KEY_LEFTALT"), (57, "KEY_SPACE"),
            (58, "KEY_CAPSLOCK"), (97, "KEY_RIGHTCTRL"), (100, "KEY_RIGHTALT"),
            (102, "KEY_HOME"), (103, "KEY_UP"), (104, "KEY_PAGEUP"),
            (105, "KEY_LEFT"), (106, "KEY_RIGHT"), (107, "KEY_END"),
            (108, "KEY_DOWN"), (109, "KEY_PAGEDOWN"), (110, "KEY_INSERT"),
            (111, "KEY_DELETE"), (125, "KEY_LEFTMETA"), (126, "KEY_RIGHTMETA"),
            (139, "KEY_MENU"), (99, "KEY_SYSRQ"), (69, "KEY_NUMLOCK"),
            (70, "KEY_SCROLLLOCK"), (119, "KEY_PAUSE"), (12, "KEY_MINUS"),
            (13, "KEY_EQUAL"), (26, "KEY_LEFTBRACE"), (27, "KEY_RIGHTBRACE"),
            (39, "KEY_SEMICOLON"), (40, "KEY_APOSTROPHE"), (41, "KEY_GRAVE"),
            (43, "KEY_BACKSLASH"), (51, "KEY_COMMA"), (52, "KEY_DOT"),
            (53, "KEY_SLASH")):
        add(EV_KEY, code, name)
    return names


VK_TO_EVDEV = _vk_to_evdev()
